# Mirrors biome.json (indentStyle: space, indentWidth: 2, lineEnding: lf).
# Biome reads this file, so it is the shared source of truth for editors too.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
