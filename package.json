{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "api:generate": "node scripts/generate-api-reference.mjs",
    "build": "next build",
    "dev": "next dev",
    "predev": "node scripts/prebuild.mjs",
    "prebuild": "node scripts/prebuild.mjs",
    "start": "next start",
    "types:check": "fumadocs-mdx && next typegen && pnpm api:generate && tsc --noEmit",
    "postinstall": "fumadocs-mdx && pnpm api:generate",
    "lint": "biome check",
    "format": "biome format --write",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,json}": [
      "pnpm format"
    ]
  },
  "dependencies": {
    "fumadocs-core": "16.17.1",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-twoslash": "^4.0.2",
    "fumadocs-typescript": "^5.5.1",
    "fumadocs-ui": "16.17.1",
    "hoshimi": "0.5.6-dev-34608641094.0",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "4.5.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3"
  }
}
