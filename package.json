{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "api:generate": "node scripts/generate-api-reference.mjs",
    "build": "next build",
    "dev": "next dev",
    "predev": "node scripts/prebuild.mjs",
    "prebuild": "node scripts/prebuild.mjs",
    "start": "next start",
    "types:check": "fumadocs-mdx && next typegen && pnpm api:generate && tsc --noEmit",
    "postinstall": "fumadocs-mdx && pnpm api:generate",
    "lint": "biome check",
    "format": "biome format --write",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,json}": [
      "pnpm format"
    ]
  },
  "dependencies": {
    "fumadocs-core": "16.14.2",
    "fumadocs-mdx": "15.2.2",
    "fumadocs-twoslash": "^3.3.0",
    "fumadocs-typescript": "^5.3.0",
    "fumadocs-ui": "16.14.2",
    "hoshimi": "0.5.2",
    "lucide-react": "^1.30.0",
    "next": "16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "4.3.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.2"
  }
}
